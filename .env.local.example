# Copy this file to .env.local for local development.
PORT=8080

MAILBUX_SMTP_HOST=my.mailbux.com
MAILBUX_SMTP_PORT=587
MAILBUX_SMTP_USER=website@rupasilverworks.com
MAILBUX_SMTP_PASS=
CONTACT_EMAIL=sales@rupasilverworks.com

# Cloudflare's official always-pass development secret.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_ALLOWED_HOSTNAME=localhost

# Change the port if the separate frontend runs elsewhere.
CONTACT_ALLOWED_ORIGINS=http://localhost:5173

